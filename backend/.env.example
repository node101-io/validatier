# ── Chain (cosmoshub-only) ──────────────────────────────────────────────
DENOM=uatom
DECIMALS=6
BECH32_PREFIX=cosmos

# ── Endpoints ────────────────────────────────────────────────────────────
# RPC = CometBFT (/status, /block, /block_results); LCD = REST (/cosmos/...).
# Public nodes are pruned: historical heights need the archive node (later).
RPC_URL=https://cosmos-rpc.polkachu.com:443
LCD_URL=https://cosmos-api.polkachu.com

# ── Stores ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/validatier
SQLITE_PATH=./data/fundflow.db

# ── Fund-flow engine ────────────────────────────────────────────────────
# Both are starting points; tuning with real data is deferred (see TASKS.md).
MAX_DEPTH=8
TIER2_MIN_INDEGREE=5
