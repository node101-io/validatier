# ── Chain (cosmoshub-only) ──────────────────────────────────────────────
DENOM=uatom
DECIMALS=6
BECH32_PREFIX=cosmos

# ── Endpoints ────────────────────────────────────────────────────────────
# RPC = CometBFT (/status, /block, /block_results); LCD = REST (/cosmos/...).
# ONLY used by the archive ingester (backend/archive/ingest.ts), which walks
# the live chain to fill R2. The running dashboard backend never calls these.
RPC_URL=https://cosmos-rpc.polkachu.com:443
LCD_URL=https://cosmos-api.polkachu.com

# The archive wrapper (backend/archive/server.ts) — what chain/client.ts's
# `chainClient` singleton actually talks to. This is what the dashboard
# backend (jobs/blockLoop.ts, jobs/validatorStats.ts, etc.) uses instead of
# RPC_URL/LCD_URL above. Local dev: run `npm run archive-server` and point
# this at it.
ARCHIVE_URL=http://127.0.0.1:8081

# ── Archive ingester + wrapper (backend/archive/) ─────────────────────────
# The ingester walks the live chain (RPC_URL/LCD_URL above) and fills this
# R2 bucket; the wrapper serves it back to the dashboard backend at
# ARCHIVE_URL. Neither is needed to run the dashboard itself in dev if
# you're pointing ARCHIVE_URL at someone else's already-running wrapper —
# these four + ARCHIVE_START_HEIGHT/CONCURRENCY are only read by
# `npm run archive-sync` and `npm run archive-server`.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 21,870,000 — first height where every tx transfer event carries
# msg_index (SDK v0.47 boundary, measured; see archive/config.ts). Do not
# lower this without re-reading the plan's msg_index section.
ARCHIVE_START_HEIGHT=21870000
ARCHIVE_INGEST_CONCURRENCY=48
ARCHIVE_SERVER_PORT=8081
ARCHIVE_CACHE_DIR=./data/archive-cache

# ── Stores ──────────────────────────────────────────────────────────────
# Mongo writes use multi-document transactions (jobs/snapshot.ts), which require
# a replica set — a plain standalone mongod on this URI will fail those calls.
# For local dev: start mongod with --replSet rs0 and run rs.initiate() once.
MONGO_URI=mongodb://127.0.0.1:27017/validatier
SQLITE_PATH=./data/fundflow.db

# ── Fund-flow engine ────────────────────────────────────────────────────
# Both are starting points; tuning with real data is deferred (see TASKS.md).
MAX_DEPTH=8
TIER2_MIN_INDEGREE=5

# ── Block loop ──────────────────────────────────────────────────────────
# How many days of blocks to scan backward from the chain tip on a fresh
# deploy (cursor never scanned), or after a restart where the persisted
# cursor has fallen further behind the tip than this (stale — jumped
# forward instead of retrying unfetchable pruned heights). No archive node
# yet, so keep this at/under the public RPC's measured pruning depth
# (~7 days). Raise it (e.g. 60) once RPC_URL/LCD_URL point at a real
# archive node.
BACKFILL_LOOKBACK_DAYS=7

# ── HTTP API (backend/api/server.ts) ─────────────────────────────────────
# Serves dashboard data to the frontend (no more static JSON export).
API_PORT=4000
