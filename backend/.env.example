# ── Chain (cosmoshub-only) ──────────────────────────────────────────────
DENOM=uatom
DECIMALS=6
BECH32_PREFIX=cosmos

# ── Endpoints ────────────────────────────────────────────────────────────
# RPC = CometBFT (/status, /block, /block_results); LCD = REST (/cosmos/...).
# Public nodes are pruned: historical heights need the archive node (later).
RPC_URL=https://cosmos-rpc.polkachu.com:443
LCD_URL=https://cosmos-api.polkachu.com

# ── Stores ──────────────────────────────────────────────────────────────
# Mongo writes use multi-document transactions (jobs/snapshot.ts), which require
# a replica set — a plain standalone mongod on this URI will fail those calls.
# For local dev: start mongod with --replSet rs0 and run rs.initiate() once.
MONGO_URI=mongodb://127.0.0.1:27017/validatier
SQLITE_PATH=./data/fundflow.db

# ── Fund-flow engine ────────────────────────────────────────────────────
# Both are starting points; tuning with real data is deferred (see TASKS.md).
MAX_DEPTH=8
TIER2_MIN_INDEGREE=5

# ── Block loop ──────────────────────────────────────────────────────────
# How many days of blocks to scan backward from the chain tip on a fresh
# deploy (cursor never scanned), or after a restart where the persisted
# cursor has fallen further behind the tip than this (stale — jumped
# forward instead of retrying unfetchable pruned heights). No archive node
# yet, so keep this at/under the public RPC's measured pruning depth
# (~7 days). Raise it (e.g. 60) once RPC_URL/LCD_URL point at a real
# archive node.
BACKFILL_LOOKBACK_DAYS=7
